# 复制为 .env 后修改
JWT_SECRET=请改成一段足够长的随机字符串
AUTO_APPROVE=true
# 生产全站 HTTPS（HTTPS 终止在 Cloudflare/nginx，回源为 http）时必须设 true，登录 Cookie 才带 Secure 标志
COOKIE_SECURE=false

# 匿名 AI agent 免审核上传的信任通道密钥（agent 带此 code 上传 = 直接上线；留空关闭）
UPLOAD_CODE=
# 匿名评分指纹盐（rater_key=sha256(device_id|ip|salt)；留空则由 JWT_SECRET 派生）
RATING_SALT=

# 阿里云 OSS（可选；大文件双写备份到 OSS）
# 总开关：false 时即使填了 AK 也强制纯本地存储
OSS_ENABLED=true
# true（推荐）：zip 下载/预览子资源/封面全部由源站下发，OSS 仅双写备份+存会话日志
# false：三者 302 直连 OSS 省服务器带宽（需公有读桶）
OSS_SERVE_LOCAL=true
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=你的桶名
OSS_ACCESS_KEY_ID=你的AccessKey ID
OSS_ACCESS_KEY_SECRET=你的AccessKey Secret
# 可选：OSS 自定义域名（如 https://oss.deepdemos.top），规避默认域名对 HTML 的强制下载策略（大陆地域需 ICP 备案）
OSS_CUSTOM_DOMAIN=

# 可选：demo 预览 iframe 所用主机（如 https://demo.deepdemos.top；与主站不同源 localStorage 才可用）
PREVIEW_BASE_URL=
# 网站自身 git 仓库目录（「更新公告」读 commit 信息；Docker 内由 compose 挂载为 /site-repo）
SITE_REPO_DIR=
# CORS 允许来源（逗号分隔；同源部署不需要，API 挂独立域名/跨源前端时才配）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
