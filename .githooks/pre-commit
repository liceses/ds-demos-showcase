#!/bin/sh
# dsh-project-model 防呆钩子：代码提交必须带上同步的骨架 hash。
#
# 背景：model-gate 的「① hash 门禁」会拦下「改了 backend/app 或 frontend/src，
# 但没重算 docs/model/pim.generated.hash」的提交（2026-09-09 热修提交 fb9f1eb
# 就是这么红过一次：改了 admin.py 却没同步 hash，豁免裁决步骤 exit 1）。
#
# 启用（每个克隆做一次）：
#     git config core.hooksPath .githooks
# 关闭：
#     git config --unset core.hooksPath
#
# 行为：暂存区里出现 backend/app 或 frontend/src 的改动时，自动跑 tooling 三件套
# 并把 docs/model/pim.generated.hash 一起加入暂存；工具缺失时只告警不阻断
# （CI 仍会校验，本地不必卡死）。

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

changed=0
echo "$staged" | grep -qE '^backend/app/' && changed=1
echo "$staged" | grep -qE '^frontend/src/' && changed=1
if [ "$changed" -eq 0 ]; then
  exit 0
fi

if ! command -v python >/dev/null 2>&1; then
  echo "[pre-commit] 未找到 python，跳过骨架重算（CI 的 hash 门禁仍会校验）"
  exit 0
fi
if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] 未找到 node，跳过骨架重算（CI 的 hash 门禁仍会校验）"
  exit 0
fi
if [ ! -f tooling/extract.py ] || [ ! -f tooling/extract-ts.mjs ] || [ ! -f tooling/merge.py ]; then
  echo "[pre-commit] 缺少 tooling 三件套，跳过骨架重算"
  exit 0
fi

tmp="${TMPDIR:-/tmp}/dsh-pim-$$"
mkdir -p "$tmp" || exit 0

echo "[pre-commit] 检测到 backend/app 或 frontend/src 改动，重算模型骨架…"
if ! python tooling/extract.py --dst "$tmp/be.json" backend/app >/dev/null; then
  echo "[pre-commit] extract.py 失败，跳过（提交继续；CI 会给出准确报错）"
  rm -rf "$tmp"
  exit 0
fi
if ! node tooling/extract-ts.mjs --src frontend/src --dst "$tmp/fe.json" >/dev/null; then
  echo "[pre-commit] extract-ts.mjs 失败，跳过（提交继续；CI 会给出准确报错）"
  rm -rf "$tmp"
  exit 0
fi
if ! python tooling/merge.py --py-fragment "$tmp/be.json" --fe-json "$tmp/fe.json" \
  --out docs/model/pim.generated.json --hash-out docs/model/pim.generated.hash >/dev/null; then
  echo "[pre-commit] merge.py 失败，跳过（提交继续；CI 会给出准确报错）"
  rm -rf "$tmp"
  exit 0
fi
rm -rf "$tmp"

git add docs/model/pim.generated.hash
echo "[pre-commit] 已同步 docs/model/pim.generated.hash（与代码同一提交，model-gate 不再漂移）"
exit 0
