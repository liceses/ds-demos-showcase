# 复制为 .env 后按需修改
DATABASE_URL=sqlite:///./data/app.db
STORAGE_DIR=./storage
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 新上传 demo 是否自动通过审核
AUTO_APPROVE=true
# 上传大小限制（字节），默认 200MB
MAX_UPLOAD_SIZE=209715200
# 单文件大小限制，默认 200MB
MAX_FILE_SIZE=209715200

# ---------- 阿里云 OSS（可选；填了之后大文件走 OSS 直连，不占服务器带宽）----------
# OSS 桶需设为「公有读 / 私有写」
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=你的桶名
OSS_ACCESS_KEY_ID=你的AccessKey ID
OSS_ACCESS_KEY_SECRET=你的AccessKey Secret
# 可选：OSS 自定义域名（绑了之后必填，如 https://oss.deepdemos.top）。
# 阿里云对「OSS默认域名」访问 HTML 会强制 x-oss-force-download 下载；
# 绑自定义域名访问可规避该策略（OSS 文档「配置访问 OSS 文件时的预览行为」）。
OSS_CUSTOM_DOMAIN=
# 预览入口公开地址（重要）：demo 预览 iframe 所用主机。
# 用「与主站不同源的子域」（如 http://demo.deepdemos.top），
# 既可安全开 allow-same-origin 让 localStorage 可用，又规避 OSS 默认域名对 HTML 的强制下载。
PREVIEW_BASE_URL=http://demo.deepdemos.top

# ---------- 可选配置 ----------
# 匿名评分 salt（留空则用 JWT_SECRET 派生）
RATING_SALT=
# 匿名上传信任通道：agent 带此 code 上传直接放行（可留空关闭）
UPLOAD_CODE=
# 存储模式总开关：false=只用本地存储，true/留空=按 OSS_* 配置决定
OSS_ENABLED=true
# 本地服务模式：true=本地服务器下发，OSS 仅作备份/存 log（省 OSS 下行钱，推荐）
OSS_SERVE_LOCAL=true
# 网站自身 git 仓库目录（用于「更新公告」= commit 信息）；Docker 内用 /site-repo
SITE_REPO_DIR=
# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
